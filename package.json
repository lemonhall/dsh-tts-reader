{
  "name": "dsh-tts-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把助手的回答用小艺的声音朗读出来：宿主侧用零依赖的 Edge TTS 客户端逐句合成，页面侧用 Web Audio 无缝连播，默认开启。",
  "main": "lib/index.js",
  "scripts": {
    "test": "node test/feed.mjs && node test/client-load.mjs",
    "test:live": "node test/host-e2e.mjs && node test/smoke.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg"
  ],
  "meta": {
    "title": "朗读回答（小艺）",
    "description": "助手每答一句就播一句：宿主侧流式取文、逐句合成，页面侧连续播放，输入框右侧可一键开关。"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
